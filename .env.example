# ============================================================
# go-drive — Docker Compose Environment (Template)
# ============================================================
# Untuk deploy VPS (Postgres di-include di compose):
#   cp .env.example .env
#   isi AUTHULA_SECRET + POSTGRES_PASSWORD
#   docker compose up -d --build
#
# DATABASE_URL TIDAK perlu diisi — docker-compose otomatis
# mengarahkan app ke service `postgres` di network internal.
# ============================================================

# --- Required ---

# Secret key untuk Authula session signing.
# Generate: openssl rand -hex 32
AUTHULA_SECRET=change-me-to-a-random-secret

# Password untuk database Postgres di compose (service postgres).
# Ganti sebelum first deploy — dipakai juga oleh DATABASE_URL app.
POSTGRES_PASSWORD=change-me

# --- Optional ---

# Kredensial Postgres (default sudah aman, bisa diubah)
# POSTGRES_DB=manajemen_tiket
# POSTGRES_USER=manajemen_tiket

# SQLite (local/dev) — pakai DB_DRIVER=sqlite + SQLITE_PATH di server/.env.
# Max open connections untuk pool SQLite (main DB + tiap tenant file, default 8).
# WAL memungkinkan reader paralel; naikkan untuk read-heavy mid/high traffic.
# SQLITE_MAX_OPEN_CONNS=8

# Port publik di host (default 8081)
# APP_PORT=8081

# Base URL — untuk auth callbacks. Set ke domain publik app.
# AUTHULA_BASE_URL=https://app.example.com

# Allowed CORS origins (comma-separated) jika API & UI beda origin.
# ALLOWED_ORIGINS=https://app.example.com

# Google Drive kredensial DI-SET dari Admin Settings (UI) — disimpan
# di DB (app_settings), jadi tidak perlu env. Env di bawah hanya
# fallback untuk development.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=
