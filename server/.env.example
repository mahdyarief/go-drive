# ============================================================
# go-drive — Environment Configuration (Template)
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Required ---

# Secret key for Authula session signing.
# Generate one with: openssl rand -hex 32
AUTHULA_SECRET=change-me-to-a-random-secret

# --- Database ---

# Database driver: "postgres" (default) or "sqlite".
# DB_DRIVER=postgres

# PostgreSQL connection string (used when DB_DRIVER=postgres).
# Format (local): postgresql://user:password@localhost:5432/dbname?sslmode=disable
# Format (Neon):  postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/gogin_db?sslmode=disable

# SQLite database file path (used when DB_DRIVER=sqlite). Directory is auto-created.
# Each organization gets its own tenant file in <dir>/tenants/tenant_<slug>.db
# (file-per-tenant isolation, the SQLite counterpart of Postgres schemas).
# SQLITE_PATH=./data/app.db

# Max open connections for the SQLite pool (main DB + each tenant file, default: 8).
# WAL mode allows concurrent readers, so a modest pool parallelizes reads for
# mid-to-high traffic. Writes stay serialized by SQLite's file lock and are
# absorbed by busy_timeout. Tune per deployment; values above ~16 rarely help.
# SQLITE_MAX_OPEN_CONNS=8

# --- Optional ---

# Server port (default: 8081)
# PORT=8081

# Authula base URL — used for auth callbacks.
# AUTHULA_BASE_URL=http://localhost:8081

# Comma-separated list of allowed CORS origins.
# Defaults to localhost dev origins (5173 Vite + 8081 Go).
# In production the frontend is same-origin, so only set this if you
# serve the API from a different origin than the UI.
# ALLOWED_ORIGINS=https://app.example.com

# Google Drive (upload bukti pembayaran) — OAuth user flow.
# Kredensial bisa di-set dari Admin Settings (UI) — tersimpan di DB (app_settings),
# sehingga mengganti Client ID tidak perlu edit file ini. Env di bawah hanya
# fallback awal / untuk development.
# Dapatkan refresh token sekali dengan: cd server && go run ./cmd/gdrive-auth
# (butuh OAuth Client ID tipe "Desktop app" di Google Cloud Console).
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=

# Enable strict Content-Security-Policy header (1 = on, default off).
# Turn this on for production; keep off in dev because Vite HMR injects inline scripts.
# CSP_ENABLED=1
